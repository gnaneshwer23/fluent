{
  "entities": {
    "WaitlistEntry": {
      "title": "Waitlist Entry",
      "description": "Information collected from people requesting early access.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "head"],
          "description": "The role of the person joining the waitlist."
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the request was made."
        }
      },
      "required": ["email", "requestedAt"]
    },
    "SchoolLead": {
      "title": "School Partnership Lead",
      "description": "Detailed institutional lead capture for B2B onboarding.",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "designation": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "studentCount": { "type": "string" },
        "classes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "contacted", "onboarded"] },
        "requestedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolName", "email", "requestedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Personalized information for registered faculty or students.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "parent", "admin", "school_admin"] },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "grade": { "type": "string" },
        "school": { "type": "string" },
        "schoolId": { "type": "string" },
        "goal": { "type": "string" },
        "onboarded": { "type": "boolean" }
      },
      "required": ["name", "role"]
    },
    "School": {
      "title": "Educational Institution",
      "description": "Information about a partner school or institution.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "adminEmail": { "type": "string", "format": "email" },
        "studentCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "onboarding", "paused"] },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "setupProgress": {
          "type": "object",
          "properties": {
            "studentsUploaded": { "type": "boolean" },
            "teachersAssigned": { "type": "boolean" },
            "classesStarted": { "type": "boolean" }
          }
        }
      },
      "required": ["name", "adminEmail", "status"]
    },
    "Cohort": {
      "title": "Academic Cohort",
      "description": "A group of students (20-30) assigned to a specific subject and grade for weekly live classes.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "subject": { "type": "string" },
        "tutorId": { "type": "string" },
        "maxStudents": { "type": "number", "default": 30 },
        "schedule": { "type": "object" },
        "avgScore": { "type": "number" },
        "attendance": { "type": "number" }
      },
      "required": ["name", "grade", "subject", "tutorId"]
    },
    "Enrollment": {
      "title": "Cohort Enrollment",
      "description": "Linking a student to a specific academic cohort.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "cohortId": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "completed", "dropped"] }
      },
      "required": ["studentId", "cohortId", "status"]
    },
    "LessonSession": {
        "title": "Lesson Session",
        "description": "A specific live class session within a cohort.",
        "type": "object",
        "properties": {
            "cohortId": { "type": "string" },
            "title": { "type": "string" },
            "date": { "type": "string", "format": "date-time" },
            "recordingUrl": { "type": "string" },
            "attendance": { "type": "object" }
        },
        "required": ["cohortId", "date"]
    },
    "Student": {
      "title": "Student Record",
      "description": "Attendance and performance data for a single student.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "studentId": { "type": "string" },
        "enrolledAt": { "type": "string" },
        "privateFeedback": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "category": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        },
        "attended": { "type": "number" },
        "total": { "type": "number" },
        "teacherId": { "type": "string", "description": "UID of the faculty member managing this record." },
        "history": { "type": "array", "items": { "type": "object" } },
        "grade": { "type": "string" }
      },
      "required": ["name"]
    },
    "PoolStudent": {
      "title": "Unassigned Student",
      "description": "Student in the registry but not currently in a class session.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "ChildRecord": {
      "title": "Monitored Child",
      "description": "A student profile being tracked by a parent.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "linkedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Booking": {
      "title": "Consultation Booking",
      "description": "A scheduled meeting between a parent/student and faculty.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "facultyId": { "type": "string" },
        "facultyName": { "type": "string" },
        "subject": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "time", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification about actions or updates.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "read", "createdAt"]
    },
    "LiveSession": {
      "title": "Live Delivery Session",
      "description": "Active real-time instructional session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "activeCount": { "type": "number" },
        "currentProtocol": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "className", "subject", "teacherId"]
    },
    "LiveMessage": {
      "title": "Live Session Message",
      "description": "Transient concept query or faculty transmission.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "student"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId", "role"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Tasks or tests assigned to students.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "batch": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "link": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "assignedTo": { "type": "string" }
      },
      "required": ["title", "dueDate"]
    },
    "ProgressReport": {
      "title": "Progress Record",
      "description": "Topic-wise marks and feedback with confidence metrics.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "cohortId": { "type": "string" },
        "sessionId": { "type": "string" },
        "marks": { "type": "number" },
        "confidenceScore": { "type": "number" },
        "communicationScore": { "type": "number" },
        "topic": { "type": "string" },
        "feedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "marks", "topic"]
    },
    "WeeklyReport": {
      "title": "Weekly Progress Report",
      "description": "Detailed weekly feedback for parents.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "parentEmail": { "type": "string" },
        "week": { "type": "string" },
        "marks": { "type": "number" },
        "confidenceScore": { "type": "number" },
        "participationScore": { "type": "number" },
        "strengths": { "type": "string" },
        "weaknesses": { "type": "string" },
        "confidenceNote": { "type": "string" },
        "communicationNote": { "type": "string" },
        "teacherComment": { "type": "string" },
        "actionPlan": { "type": "string" },
        "attendance": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["studentId", "week", "marks", "parentEmail"]
    },
    "TeacherAnalytics": {
      "title": "Teacher Analytics",
      "description": "Aggregated performance metrics for faculty.",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "avgMarks": { "type": "number" },
        "avgConfidence": { "type": "number" },
        "avgParticipation": { "type": "number" },
        "attendanceRate": { "type": "number" },
        "rating": { "type": "number" },
        "studentCount": { "type": "number" },
        "month": { "type": "string" }
      },
      "required": ["teacherId", "avgMarks", "month"]
    },
    "TeacherGrowth": {
      "title": "Teacher Growth",
      "description": "Historical performance data for faculty tracking.",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "month": { "type": "string" },
        "avgMarks": { "type": "number" },
        "avgConfidence": { "type": "number" },
        "avgParticipation": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "month", "avgMarks"]
    },
    "ForumMessage": {
      "title": "Forum Message",
      "description": "Global communication transmission.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "topic": { "type": "string" },
        "schoolId": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "userId", "topic"]
    },
    "MasteryResource": {
      "title": "Mastery Resource",
      "description": "Synthesized academic node or study material.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["guide", "paper", "video", "interactive"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "authorName": { "type": "string" },
        "isAiGenerated": { "type": "boolean" },
        "tier": { "type": "string", "enum": ["foundation", "advanced", "elite"] },
        "downloads": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "type", "tier"]
    },
    "CurriculumChunk": {
      "title": "Curriculum Chunk",
      "description": "Knowledge unit for RAG system grounding.",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "chapter": { "type": "string" },
        "topic": { "type": "string" },
        "content": { "type": "string" },
        "metadata": { "type": "object" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "grade", "content"]
    }
  },
  "firestore": {
    "waitlist": {
      "schema": "WaitlistEntry",
      "description": "Collection of waitlist requests."
    },
    "users": {
        "schema": "UserProfile",
        "description": "User profile data."
    },
    "users/{userId}/monitoredStudents": {
        "schema": "ChildRecord",
        "description": "Students being monitored by a parent."
    },
    "users/{userId}/notifications": {
        "schema": "Notification",
        "description": "User notifications."
    },
    "forum_messages": {
        "schema": "ForumMessage",
        "description": "Global forum messages for community discourse."
    },
    "mastery_resources": {
        "schema": "MasteryResource",
        "description": "Stored academic resources and synthesized briefs."
    },
    "platform": {
        "schema": {
            "type": "object",
            "properties": {
                "globalChat": { "type": "boolean" },
                "directive": { "type": "string" },
                "directiveUpdatedAt": { "type": "string", "format": "date-time" }
            }
        },
        "description": "Global platform configurations and broadcasts."
    },
    "bookings": {
        "schema": "Booking",
        "description": "Consultation bookings with faculty."
    },
    "cohorts": {
        "schema": "Cohort",
        "description": "Class cohorts managed by faculty."
    },
    "cohorts/{cohortId}/students": {
        "schema": "Student",
        "description": "Students enrolled in a specific cohort."
    },
    "enrollments": {
        "schema": "Enrollment",
        "description": "Student enrollment tracking."
    },
    "lessonSessions": {
        "schema": "LessonSession",
        "description": "Specific class sessions and recordings."
    },
    "studentPool": {
        "schema": "PoolStudent",
        "description": "Registry of students available for assignment."
    },
    "liveSessions": {
        "schema": "LiveSession",
        "description": "Active real-time instructional sessions."
    },
    "liveSessions/{sessionId}/messages": {
        "schema": "LiveMessage",
        "description": "Concept feed for a specific session."
    },
    "assignments": {
        "schema": "Assignment",
        "description": "Assignments and tests."
    },
    "progress": {
        "schema": "ProgressReport",
        "description": "Detailed progress records for students."
    },
    "weeklyReports": {
        "schema": "WeeklyReport",
        "description": "Weekly reports generated for parents."
    },
    "attendance": {
        "schema": {
          "type": "object",
          "properties": {
            "studentId": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "status": { "type": "string", "enum": ["Present", "Absent"] },
            "batch": { "type": "string" }
          },
          "required": ["studentId", "date", "status"]
        },
        "description": "Student attendance logs."
    },
    "teacherAnalytics": {
        "schema": "TeacherAnalytics",
        "description": "Performance data for faculty members."
    },
    "alerts": {
        "schema": {
          "type": "object",
          "properties": {
            "studentId": { "type": "string" },
            "teacherId": { "type": "string" },
            "type": { "type": "string" },
            "message": { "type": "string" },
            "date": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["active", "resolved"] }
          },
          "required": ["type", "message", "status"]
        },
        "description": "System-generated intervention alerts for students and faculty."
    },
    "teacherGrowth": {
        "schema": "TeacherGrowth",
        "description": "Historical performance data for faculty tracking."
    },
    "schools": {
        "schema": "School",
        "description": "Institutional partners and schools."
    },
    "schoolLeads": {
        "schema": "SchoolLead",
        "description": "B2B institutional partnership leads."
    },
    "curriculum_chunks": {
        "schema": "CurriculumChunk",
        "description": "Source knowledge for AI grounding."
    },
    "admins": {
        "schema": {
            "type": "object",
            "properties": {
                "email": { "type": "string" },
                "addedAt": { "type": "string", "format": "date-time" }
            }
        },
        "description": "Registry of system-level platform administrators."
    }
  }
}
