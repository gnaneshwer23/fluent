rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Waitlist collection
    match /waitlist/{entryId} {
      allow create: if isValidWaitlistEntry(request.resource.data);
      allow read, update, delete: if false; // Only allow creation from client
    }

    // Validation helper
    function isValidWaitlistEntry(data) {
      return data.email is string && 
             data.email.size() > 0 && 
             data.email.size() <= 256 &&
             data.requestedAt == request.time &&
             (data.role == null || (data.role in ['student', 'teacher', 'head']));
    }
  }
}
