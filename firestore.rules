rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Bootstrapped Admin check
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email_verified == true && (
          request.auth.token.email == 'drbiryanihelp@gmail.com' ||
          request.auth.token.email == 'gnaneshwer.jadav@gmail.com' ||
          request.auth.token.email == 'mindmeshaisolutions@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        )
      ); 
    }
    
    function isTeacher() { 
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'school_admin' && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId)
      );
    }
    
    // --- Schema Validators ---
    function isValidUserProfile(data) {
        return data.name is string && data.name.size() >= 2 && data.name.size() <= 100
            && data.role is string && (data.role == 'student' || data.role == 'teacher' || data.role == 'parent' || data.role == 'admin' || data.role == 'school_admin');
    }

    function isValidSchool(data) {
        return data.name is string && data.name.size() > 0
            && data.adminEmail is string && data.adminEmail.size() > 0
            && (data.status == 'active' || data.status == 'onboarding' || data.status == 'paused');
    }

    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isTeacher());
      allow list: if isAdmin() || isTeacher();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) 
        && isValidUserProfile(incoming())
        && (isAdmin() || (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'subjects', 'grade', 'school', 'goal', 'onboarded', 
              'preferences', 'learningGoals', 'preferredStudyMethods', 
              'learningStyles', 'studyTime', 'schoolId'
            ]) && incoming().role == existing().role
        ));
      
      match /monitoredStudents/{studentId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Cohorts & Roster (Hardened) ---
    match /cohorts/{cohortId} {
      allow read: if isSignedIn();
      // Only tutor can write
      allow write: if isSignedIn() && (
        (exists(/databases/$(database)/documents/cohorts/$(cohortId)) && get(/databases/$(database)/documents/cohorts/$(cohortId)).data.tutorId == request.auth.uid) ||
        (!exists(/databases/$(database)/documents/cohorts/$(cohortId)) && incoming().tutorId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isAdmin());
      allow create: if isTeacher() || isAdmin() || (isSignedIn() && incoming().studentId == request.auth.uid);
      allow update, delete: if isTeacher() || isAdmin();
    }

    match /lessonSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // --- Collection Group: Students (Enables specialized dashboards) ---
    match /{path=**}/students/{studentId} {
      allow list, get: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isAdmin() || isTeacher());

      match /internal_notes/{noteId} {
        allow read, write: if isTeacher() || isAdmin();
      }
    }

    // --- Bookings (Hardened) ---
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
    }

    // --- Student Pool ---
    match /studentPool/{poolId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn(); // Simplified for now, but should ideally check ownership
    }

    // --- Live Sessions (Adaptive Synthesis Hub) ---
    match /liveSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Teacher can update protocol
        (resource.data.teacherId == request.auth.uid) ||
        // Students can update activeCount (increment/decrement)
        (incoming().diff(existing()).affectedKeys().hasOnly(['activeCount']))
      );
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
          && incoming().senderId == request.auth.uid
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000
          && incoming().createdAt == request.time;
      }

      match /scholars/{scholarId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == scholarId;
      }
    }

    match /forum_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /mastery_resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /platform/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /waitlist/{entryId} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }

    match /schoolLeads/{leadId} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Assignments ---
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // --- Progress Records ---
    match /progress/{reportId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isAdmin());
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // --- Weekly Reports ---
    match /weeklyReports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid || 
        resource.data.studentId == request.auth.uid ||
        request.auth.token.email == resource.data.parentEmail || 
        isAdmin() ||
        isSchoolAdmin(resource.data.schoolId)
      );
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // --- Attendance ---
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        resource.data.teacherId == request.auth.uid || 
        isAdmin() ||
        isSchoolAdmin(resource.data.schoolId)
      );
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // --- Teacher Analytics ---
    match /teacherAnalytics/{analyticsId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.teacherId || isAdmin());
      allow create, update, delete: if isAdmin(); // Only system/admin typically updates these, but let's allow teachers to read their own
    }

    // --- Alerts ---
    match /alerts/{alertId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid || isTeacher() || isAdmin());
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isTeacher() || isAdmin();
    }

    // --- Teacher Growth ---
    match /teacherGrowth/{growthId} {
      allow read: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow write: if isTeacher() || isAdmin();
    }

    // --- Notifications Hub ---
    match /notifications/{notifyId} {
      allow read: if isAdmin();
      allow create: if true; // Allows the system/app to log notifications sent
    }

    // --- RAG Curriculum Chunks ---
    match /curriculum_chunks/{chunkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    // --- Schools ---
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidSchool(incoming());
      allow update: if (isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'school_admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId))
        && isValidSchool(incoming())
        && (isAdmin() || (
          incoming().name == existing().name &&
          incoming().adminEmail == existing().adminEmail &&
          (existing().status != 'active' || incoming().status == 'active')
        ));
      allow delete: if isAdmin();
    }

    // --- Payments ---
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.parentEmail == request.auth.token.email));
      allow create: if isSignedIn(); // Usually system or user during checkout
      allow update, delete: if isAdmin();
    }
  }
}
