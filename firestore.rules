rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    
    // --- Schema Validators ---
    function isValidUserProfile(data) {
        return data.name is string && data.name.size() >= 2 && data.name.size() <= 100
            && data.role is string && (data.role == 'student' || data.role == 'teacher' || data.role == 'parent' || data.role == 'admin')
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'subjects', 'grade', 'school', 'goal', 'onboarded']);
    }

    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUserProfile(incoming());
      
      match /monitoredStudents/{studentId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Classes & Roster (Hardened) ---
    match /classes/{classId} {
      allow read: if isSignedIn();
      // Only owner can write
      allow write: if isSignedIn() && exists(/databases/$(database)/documents/classes/$(classId)) && get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid;

      match /students/{studentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && exists(/databases/$(database)/documents/classes/$(classId)) && get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid;
      }
    }

    // --- Bookings (Hardened) ---
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Student Pool ---
    match /studentPool/{poolId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /waitlist/{entryId} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }
  }
}
